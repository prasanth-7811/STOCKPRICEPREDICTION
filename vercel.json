{
  "version": 2,
  "builds": [
    {
      "src": "stock-price-ann/api/index.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "stock-price-ann/src/**",
          "stock-price-ann/data/**",
          "stock-price-ann/requirements.txt"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "stock-price-ann/api/index.py"
    }
  ]
}
