{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "api/index.py"
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "entrypoint": "api/index.py"
    },
    "stock-price-ann": {
      "root": "stock-price-ann",
      "framework": "fastapi",
      "entrypoint": "api/index.py"
    }
  },
  "rewrites": [
    {
      "source": "/backend/(.*)",
      "destination": { "service": "backend" }
    },
    {
      "source": "/stock/(.*)",
      "destination": { "service": "stock-price-ann" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}
